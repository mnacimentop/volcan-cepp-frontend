{
  "name": "axis-frontend-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "commit": "cz",
    "commit:all": "git add . && pnpm lint:fix && git add . && cz",
    "prepare": "husky",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['.next','coverage','playwright-report']) fs.rmSync(path,{ recursive:true, force:true });\"",
    "dev:network": "node ./scripts/http-toolkit/dev-with-http-toolkit.mjs",
    "network:check": "node ./scripts/http-toolkit/check-http-toolkit.mjs"
  },
  "dependencies": {
    "@pormeldev/axis-client-kit": "0.9.1-beta.0",
    "@pormeldev/axis-common-lib": "2.1.1-beta.3",
    "@pormeldev/axis-design-system": "2.48.0",
    "@pormeldev/axis-service-httpclient": "2.2.0-beta.5",
    "@pormeldev/axis-service-httpclient-fetch": "1.1.0-beta.9",
    "@pormeldev/axis-service-logger": "3.0.2-beta.3",
    "@pormeldev/axis-service-logger-pino": "3.0.2-beta.3",
    "@pormeldev/axis-shared": "0.7.0",
    "@pormeldev/next-runtime-kit": "1.5.1",
    "jose": "^5.9.6",
    "next": "16.3.0",
    "next-intl": "^4.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.49.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "react-doctor": "^0.9.11",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
